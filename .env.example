# Copy this file to `.env` and fill in the values you need.
# Nothing here is secret — real keys live only in your local .env (gitignored)
# or in the hosting provider's environment variables.

# ----------------------------------------------------------------- app
# PIN that opens the app. CHANGE IT — the app may be on a public URL.
APP_PIN=1234

# Shop name printed on the payout sheet.
SHOP_NAME=Ателье

# Port for local runs (ignored on Vercel).
PORT=3000

# --------------------------------------------------------------- vision
# Which model reads the invoice photos. The provider is picked from the name:
#   claude-*            -> Anthropic API      (ANTHROPIC_API_KEY)
#   gemini-*            -> Google Gemini API  (GEMINI_API_KEY)
#   vendor/model        -> OpenRouter         (OPENROUTER_API_KEY)
# Leave every key empty to run without recognition — invoices can still be
# typed in by hand.
VISION_MODEL=anthropic/claude-sonnet-5

# Tried in order if the model above fails, is rate-limited or overloaded.
# May mix providers. If all of them fail a photo becomes a flagged
# manual-entry row — never a confident-but-wrong number.
VISION_FALLBACK_MODELS=gemini-2.5-flash

# One key per provider you actually use.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------- cloud mode
# Leave these unset to run locally: SQLite in data/payroll.db and photos in
# data/photos/. Set them (e.g. on Vercel) to store data in the cloud instead.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# BLOB_READ_WRITE_TOKEN=
